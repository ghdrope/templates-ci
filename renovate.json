{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "useBaseBranchConfig": "merge",
  "reviewers": ["ghdrope"],
  "labels": ["renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflow env vars with a `# renovate:` comment",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "GitHub Workflows",
      "commitMessageTopic": "GitHub Workflows"
    }
  ]
}
